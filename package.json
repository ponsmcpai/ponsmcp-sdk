{
  "name": "@ponsmcp/sdk",
  "version": "2.3.0",
  "description": "PonsMCP SDK + MCP server - autonomous agent payments (MPP) settled in USDG on Robinhood Chain 4663 or USDC on Base 8453, with pons launch intelligence tools.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ponsmcp": "dist/mcp.js",
    "ponsmcp-setup": "dist/setup.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/mcp.js",
    "test:e2e": "node test/e2e.ts",
    "test:unit": "node --test test/units/",
    "test:security": "node --test test/security.test.mjs",
    "test:serial": "node test/serial_suite.mjs",
    "test:all": "npm run test:unit && npm run test:security && node --test test/new_tools.test.mjs && npm run test:serial",
    "test:coverage": "c8 --reporter=lcov --reporter=text node --test test/units/ test/security.test.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pons",
    "robinhood-chain",
    "ai-agents",
    "payments"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "c8": "^12.0.0",
    "typescript": "^5.6.0"
  }
}
